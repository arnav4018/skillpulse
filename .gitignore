# Secrets — never commit real API keys
.env

# job_tracker.db IS committed from Phase 2 onward — GitHub Actions has no
# persistent disk, so the DB has to live in the repo to survive between
# scheduled runs. Only ignore OTHER local/test databases here.
*.db
!job_tracker.db

# Python
__pycache__/
*.pyc
.venv/
venv/

# OS clutter
.DS_Store
